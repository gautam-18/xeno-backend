generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String     @id @default(cuid())
  name        String
  shopDomain  String     // e.g. "my-shop.myshopify.com"
  accessToken String     // Shopify Admin API access token

  users       User[]
  customers   Customer[]
  products    Product[]
  orders      Order[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([shopDomain])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String

  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id         String   @id @default(cuid())
  shopifyId  String
  email      String?
  firstName  String?
  lastName   String?
  phone      String?
  totalSpent Decimal? @db.Decimal(12, 2)
  rawJson    Json

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, shopifyId])
}

model Product {
  id         String   @id @default(cuid())
  shopifyId  String
  title      String
  sku        String?
  price      Decimal? @db.Decimal(12, 2)
  rawJson    Json

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, shopifyId])
}

model Order {
  id                 String   @id @default(cuid())
  shopifyId          String
  orderNumber        Int?
  totalPrice         Decimal? @db.Decimal(12, 2)
  currency           String?
  processedAt        DateTime?
  customerShopifyId  String?
  rawJson            Json

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, shopifyId])
}
